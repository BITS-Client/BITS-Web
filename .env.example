# BITS Corporate Platform Environment Variables
# Copy this file to .env and fill in the values

# Public variables (exposed to the client)
# PUBLIC_API_URL=https://api.example.com

# Private variables (server-side only)
# DATABASE_URL=
# API_SECRET_KEY=

# Sanity CMS Configuration
# Get these values from https://www.sanity.io/manage
VITE_SANITY_PROJECT_ID=your-project-id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# Contact Form API Configuration
# Cloudflare Turnstile keys for bot protection
# Get from: https://dash.cloudflare.com/
# Public site key (exposed to client)
# For production: use your actual site key
# For development: defaults to 0x4AAAAAACEIn-rYc15eCGx7 if not set
VITE_TURNSTILE_SITE_KEY=0x4AAAAAACEIn-rYc15eCGx7
# Secret key (server-side only)
# For production: use your actual secret key
# For development: defaults to 0x4AAAAAAACEIn84L8pN--7921SPbxZKaInI if not set
TURNSTILE_SECRET_KEY=0x4AAAAAAACEIn84L8pN--7921SPbxZKaInI

# Resend API key for sending emails
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key

# Email configuration (used by Contact Form and Newsletter APIs)
# Admin email address to receive contact form submissions and newsletter notifications
ADMIN_EMAIL=admin@yourdomain.com

# Sender email for Contact Form (requires verified domain in Resend)
CONTACT_FROM_EMAIL=Your Company <contact@yourdomain.com>

# Sender email for Newsletter (requires verified domain in Resend)
NEWSLETTER_FROM_EMAIL=Your Company Newsletter <newsletter@yourdomain.com>
