# BITS Corporate Website Environment Variables
# Copy this file to .env and fill in the values
# Local dev: use .env · CI/Production: use GitHub secrets (see README Deployment)

# ── Sanity CMS (build-time, public) ─────────────────────────────────────────
# Get these values from https://www.sanity.io/manage
VITE_SANITY_PROJECT_ID=j996ej4v
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# ── Cloudflare Turnstile (bot protection) ───────────────────────────────────
# Public site key (exposed to client) — https://dash.cloudflare.com/
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA_placeholder_site_key

# Secret key (server-side only) — NEVER commit the real value
TURNSTILE_SECRET_KEY=0x4AAAAAAA_placeholder_secret_key

# ── Resend (email delivery) ─────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_placeholder

# ── Email routing ───────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
CONTACT_FROM_EMAIL=Your Company <contact@yourdomain.com>
NEWSLETTER_FROM_EMAIL=Your Company Newsletter <newsletter@yourdomain.com>

# ── Sanity scripts (pnpm export / pnpm seed) ────────────────────────────────
# These live in sanity/.env (see sanity/.env.example), not here
