# BITS Corporate Website Environment Variables
# Copy this file to .env and fill in the values
# Local dev: use .env · CI/Production: GitHub variables (public config) + secrets (private), see README Deployment

# ── Site / Contact ────────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://bits.co.id
PUBLIC_PHONE_DISPLAY=+62 819 678 048
PUBLIC_WHATSAPP_NUMBER=62819678048

# ── Sanity CMS (build-time, public) ─────────────────────────────────────────
# Get these values from https://www.sanity.io/manage
PUBLIC_SANITY_PROJECT_ID=j996ej4v
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-01-01

# ── Cloudflare Turnstile (bot protection) ───────────────────────────────────
# Public site key (exposed to client) — https://dash.cloudflare.com/
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_placeholder_site_key

# Secret key (server-side only) — NEVER commit the real value
TURNSTILE_SECRET_KEY=0x4AAAAAAA_placeholder_secret_key

# ── Resend (email delivery) ─────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_placeholder

# ── Email routing (sender must use a Resend-verified domain) ────────────────
PUBLIC_CONTACT_EMAIL=admin@yourdomain.com
PUBLIC_CONTACT_TO_EMAIL=admin@yourdomain.com
PUBLIC_CONTACT_FROM_EMAIL=Your Company <contact@yourdomain.com>

# ── Sanity scripts (pnpm export / pnpm seed) ────────────────────────────────
# These live in sanity/.env (see sanity/.env.example), not here
