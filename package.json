{
	"name": "bits-web",
	"version": "0.0.1",
	"private": true,
	"description": "BITS Corporate Website — multilingual corporate site for Banten IT Solutions on SvelteKit, deployed to Cloudflare Pages",
	"keywords": [
		"bits",
		"corporate-website",
		"cloudflare-pages",
		"i18n",
		"landing-page",
		"resend",
		"sanity",
		"svelte",
		"sveltekit",
		"tailwindcss",
		"typescript"
	],
	"license": "MIT",
	"author": {
		"name": "Banten IT Solutions",
		"email": "admin@bits.co.id",
		"url": "https://bits.co.id"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BITS-Client/BITS-Web.git"
	},
	"bugs": {
		"url": "https://github.com/BITS-Client/BITS-Web/issues"
	},
	"homepage": "https://bits.co.id",
	"type": "module",
	"scripts": {
		"build": "pnpm --filter bits-web-app build && pnpm --filter bits-studio build",
		"check": "pnpm --filter bits-web-app check",
		"lint": "pnpm --filter bits-web-app lint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"audit:seed": "node studio/scripts/audit-seed.mjs",
		"seed": "node studio/scripts/seed.mjs",
		"seed:safe": "node studio/scripts/seed-safe.mjs",
		"export": "node studio/scripts/export.mjs",
		"prepare": "simple-git-hooks || echo ''"
	},
	"devDependencies": {
		"lint-staged": "^17.4.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"simple-git-hooks": "^2.14.0"
	},
	"simple-git-hooks": {
		"pre-commit": "npx --no-install lint-staged",
		"pre-push": "pnpm run check && pnpm run build"
	},
	"lint-staged": {
		"*.{js,ts,svelte,json,css,md,yml,yaml}": "prettier --write",
		"web/**/*.{ts,svelte}": "pnpm --filter bits-web-app exec eslint --fix"
	},
	"packageManager": "pnpm@10.34.0"
}
