# Static assets (except favicon)
static/images/
!static/images/favicon.svg

# Sanity - exclude bloat backup (157M assets + raw duplicates)
# Keep only sanity/data/*.json (published, ~5MB) for seed --skip-assets
sanity/data/assets/
sanity/data/*.raw.json
sanity/data/all-documents.raw.json
sanity/data/all-data.raw.json
sanity/data/drafts-data.json
sanity/data/assets-manifest.json

# Sanity build & cache (artifacts)
sanity/dist/
sanity/.sanity/
.sanity/

# Env token - ensure nested sanity/.env is ignored (root .env already above)
**/.env
**/.env.local
sanity/.env

# Ensure node_modules ignored at all levels
**/node_modules/
pnpm-debug.log*
